{
  "name": "@eakerzt/yiz-ui",
  "version": "0.0.7",
  "description": "",
  "keywords": [
    "ui",
    "vue"
  ],
  "homepage": "https://eakerzt.github.io/yiz-ui/",
  "bugs": {
    "url": "https://github.com/EakerZT/yiz-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EakerZT/yiz-ui.git"
  },
  "license": "MIT",
  "author": "EakerZT",
  "main": "./dist/yiz-ui.cjs",
  "module": "./dist/yiz-ui.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/yiz-ui.mjs",
      "require": "./dist/yiz-ui.cjs"
    },
    "./dist/yiz-ui.css": "./dist/yiz-ui.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "demo": "vite",
    "demo:build": "vite build --config vite.config.demo.mts",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build --config vite.config.lib.mts && vue-tsc --project tsconfig.build.json",
    "prepublishOnly": "yarn typecheck && yarn build"
  },
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "volta": {
    "node": "25.9.0",
    "yarn": "1.22.22"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.330",
    "@types/node": "^25.9.3",
    "@vicons/fluent": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.39.4",
    "less": "^4.6.4",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.5",
    "vue": "^3.5.24",
    "vue-tsc": "^3.3.4"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.2.0"
  }
}
